# Copy to .env. Never commit .env. Generate key: python -m docagent.cli key
DOCAGENT_ENV=development
# DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
DOCAGENT_LOG_LEVEL=INFO
# Per-request timeout and total AI synthesis budget; static findings survive limits/failures.
DOCAGENT_AI_REQUEST_TIMEOUT_SECONDS=60
DOCAGENT_AI_TIME_BUDGET_SECONDS=300
DOCAGENT_PUBLIC_URL=http://localhost:8000
DOCAGENT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DOCAGENT_DATABASE_URL=sqlite:///.data/docagent.db
DOCAGENT_DATA_DIR=.data
# Artifact storage: local (default) or s3 (Amazon S3 and MinIO).
# DATA_DIR is still required for temporary work and local runtime state.
DOCAGENT_STORAGE_BACKEND=local
DOCAGENT_S3_BUCKET=
DOCAGENT_S3_REGION=us-east-1
# Leave empty for AWS; MinIO example: http://localhost:9000 (S3 API, not console).
DOCAGENT_S3_ENDPOINT_URL=
DOCAGENT_S3_PREFIX=docagent
# Leave both empty to use the AWS credential chain / IAM role.
DOCAGENT_S3_ACCESS_KEY_ID=
DOCAGENT_S3_SECRET_ACCESS_KEY=
DOCAGENT_S3_SESSION_TOKEN=
# Use path for MinIO; auto or virtual for AWS.
DOCAGENT_S3_ADDRESSING_STYLE=auto
DOCAGENT_ENCRYPTION_KEY=<GENERATED_KEY>
DOCAGENT_JOB_BACKEND=local
# In-memory fakeredis needs no Redis server. Switch to real for an external Redis service.
DOCAGENT_REDIS_BACKEND=fake
# Ignored in fake mode. Celery requires REDIS_BACKEND=real.
DOCAGENT_REDIS_URL=redis://localhost:6379/0
DOCAGENT_MAX_CONCURRENT_JOBS=2
DOCAGENT_GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
DOCAGENT_GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
# read:user for public repos; classic OAuth repo scope is broader than read-only.
# Prefer fine-grained PATs with Metadata:read and Contents:read for private repos.
DOCAGENT_GITHUB_OAUTH_SCOPES=read:user
DOCAGENT_REVIEWERS=<GITHUB_USERNAME_1>,<GITHUB_USERNAME_2>
DOCAGENT_OPENAI_API_KEY=
DOCAGENT_ANTHROPIC_API_KEY=
DOCAGENT_GEMINI_API_KEY=
# Model IDs are deliberately configurable. Use models available in your account.
DOCAGENT_OPENAI_MODEL=<OPENAI_MODEL_ID>
DOCAGENT_ANTHROPIC_MODEL=<ANTHROPIC_MODEL_ID>
DOCAGENT_GEMINI_MODEL=<GEMINI_MODEL_ID>
DOCAGENT_RETENTION_DAYS=30
# Disabled unless an administrator supplies a prebuilt, trusted test image.
DOCAGENT_TEST_EXECUTION_ENABLED=false
DOCAGENT_TEST_IMAGE=
# Compose reuses existing containers on this external network.
# Generate its container URLs with: docagent compose-env
DOCAGENT_DOCKER_NETWORK=infra-shared
DOCAGENT_API_PORT=8000
